{
    "name": "yiisoft/yii2-app-basic",
    "description": "Yii 2 Basic Project Template",
    "keywords": ["yii2", "framework", "basic", "project template"],
    "homepage": "http://www.yiiframework.com/",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii2/issues?state=open",
        "forum": "http://www.yiiframework.com/forum/",
        "wiki": "http://www.yiiframework.com/wiki/",
        "irc": "irc://irc.freenode.net/yii",
        "source": "https://github.com/yiisoft/yii2"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=5.4.0",
        "yiisoft/yii2": "^2.0",
        "yiisoft/yii2-bootstrap": "~2.0.0",
        "dmstr/yii2-adminlte-asset": "^2.1",
        "yiisoft/yii2-imagine": "^2.1",
        "kartik-v/yii2-widget-datepicker": "@dev",
        "kartik-v/yii2-field-range": "*",
        "2amigos/yii2-date-picker-widget": "~1.0",
        "phpoffice/phpspreadsheet": "^1.28",
        "zgb7mtr/yii2-bootstrap-color-picker": "~1.0",
        "kartik-v/yii2-widget-colorinput": "dev-master",
        "alexantr/yii2-colorpicker": "^2.0",
        "imangazaliev/didom": "^2.0",
        "yiisoft/yii2-faker": "^2.0",
        "yiisoft/yii2-swiftmailer": "^2.1",
        "2amigos/yii2-tinymce-widget": "^1.1",
        "tinymce/tinymce": "5.1",
        "edsdk/flmngr-server-php": "^1.5",
        "kartik-v/yii2-widget-select2": "@dev",
        "dompdf/dompdf": "^2.0",
        "yiisoft/yii2-symfonymailer": "^3.0",
        "wapmorgan/yii2-inflection": "^1.0",
        "ezyang/htmlpurifier": "^4.17",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "^2.1",
        "yiisoft/yii2-gii": "^2.2",
        "overtrue/phplint": "^5.3",
        "friendsofphp/php-cs-fixer": "^3.13",
        "zircote/swagger-php": "^4.7",
        "bower-asset/swagger-ui": "^4.18"
    },
    "config": {
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "lint": "phplint --exclude=vendor",
        "php-cs-fixer": "php-cs-fixer --config=.php-cs-fixer.php --allow-risky=yes",
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
